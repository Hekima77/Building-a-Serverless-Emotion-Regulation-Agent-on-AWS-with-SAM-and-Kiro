# Production environment variables
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=emotion-interaction-logs-prod

# S3 Configuration
S3_BUCKET_NAME=emotion-regulation-animations-prod
S3_ANIMATION_KEY=breathing-animation.html

# Lambda Configuration
LAMBDA_FUNCTION_NAME=emotion-breathing-routine-prod

# Polly Configuration
POLLY_VOICE_ID=Joanna

# Application Configuration
LOG_LEVEL=info
ENABLE_AUDIO=true
ENABLE_ANIMATION=true
